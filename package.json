{
  "name": "pair-review",
  "displayName": "Pair Review",
  "description": "Review local changes and GitHub pull requests with Claude Code on one review page, with automatic feedback delivery.",
  "version": "0.4.12",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#101B29",
    "theme": "dark"
  },
  "publisher": "kaiketsu-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaiketsu-labs/pair-review.git"
  },
  "homepage": "https://github.com/kaiketsu-labs/pair-review#readme",
  "bugs": {
    "url": "https://github.com/kaiketsu-labs/pair-review/issues"
  },
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=20"
  },
  "categories": [
    "SCM Providers",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "code review",
    "comments",
    "pull request",
    "ai",
    "inline review",
    "git",
    "diff",
    "peer review"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onView:pairReview.pullRequests",
    "onFileSystem:pair-review-pr",
    "onView:pairReview.local"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Pair Review connects to a coding agent that can edit workspace files."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "vscode:prepublish": "npm run build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node scripts/test.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "highlight.js": "11.12.0",
    "jsonc-parser": "3.3.1",
    "markdown-it": "15.0.3",
    "parse5": "8.0.1",
    "pdfjs-dist": "4.10.38",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "contributes": {
    "colors": [
      {
        "id": "pairReview.selectionBackground",
        "description": "Hintergrund der fixierten Codeauswahl für den aktiven Review-Kommentar.",
        "defaults": {
          "dark": "#FFFFFF1A",
          "light": "#0000000F",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "pairReview.selectionBorder",
        "description": "Rahmen der fixierten Codeauswahl für den aktiven Review-Kommentar.",
        "defaults": {
          "dark": "#FFFFFF66",
          "light": "#00000059",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      }
    ],
    "commands": [
      {
        "command": "pairReview.startClaude",
        "title": "Mit Claude verbinden",
        "category": "Pair Review",
        "icon": "$(plug)"
      },
      {
        "command": "pairReview.copyClaudeCommand",
        "title": "Verbindungsbefehl kopieren",
        "category": "Pair Review",
        "icon": "$(terminal)"
      },
      {
        "command": "pairReview.connectRunningClaude",
        "title": "Laufende Unterhaltung verbinden",
        "category": "Pair Review",
        "icon": "$(plug)"
      },
      {
        "command": "pairReview.addComment",
        "title": "Comment in review page",
        "category": "Pair Review",
        "icon": "$(comment-add)"
      },
      {
        "command": "pairReview.openLocalReview",
        "title": "Review local changes",
        "category": "Pair Review",
        "icon": "$(git-compare)"
      },
      {
        "command": "pairReview.openLocalFile",
        "title": "Show on review page",
        "category": "Pair Review"
      },
      {
        "command": "pairReview.openLocalFileInEditor",
        "title": "Open in editor",
        "category": "Pair Review",
        "icon": "$(go-to-file)"
      },
      {
        "command": "pairReview.refreshLocalFiles",
        "title": "Refresh files",
        "category": "Pair Review",
        "icon": "$(refresh)"
      },
      {
        "command": "pairReview.refreshPullRequests",
        "title": "Refresh pull requests",
        "category": "Pair Review",
        "icon": "$(refresh)"
      },
      {
        "command": "pairReview.searchPullRequests",
        "title": "Search pull requests",
        "category": "Pair Review",
        "icon": "$(search)"
      },
      {
        "command": "pairReview.cleanUpWorktrees",
        "title": "Clean up worktrees",
        "category": "Pair Review",
        "icon": "$(trash)"
      },
      {
        "command": "pairReview.signInToGitHub",
        "title": "Sign in to GitHub",
        "category": "Pair Review",
        "icon": "$(account)"
      },
      {
        "command": "pairReview.filterByAuthor",
        "title": "Filter by author",
        "category": "Pair Review",
        "icon": "$(filter)"
      },
      {
        "command": "pairReview.filterByAuthorActive",
        "title": "Filter by author",
        "category": "Pair Review",
        "icon": "$(filter-filled)"
      },
      {
        "command": "pairReview.showGuideInTree",
        "title": "Show guide steps under PRs",
        "category": "Pair Review",
        "icon": "$(map)"
      },
      {
        "command": "pairReview.showFilesInTree",
        "title": "Show files under PRs",
        "category": "Pair Review",
        "icon": "$(files)"
      },
      {
        "command": "pairReview.viewFilesAsTree",
        "title": "View as tree",
        "category": "Pair Review",
        "icon": "$(list-tree)"
      },
      {
        "command": "pairReview.viewFilesAsList",
        "title": "View as list",
        "category": "Pair Review",
        "icon": "$(list-flat)"
      },
      {
        "command": "pairReview.groupByRole",
        "title": "Group by role",
        "category": "Pair Review"
      },
      {
        "command": "pairReview.groupByRepository",
        "title": "Group by repository",
        "category": "Pair Review"
      },
      {
        "command": "pairReview.chooseRepositories",
        "title": "Choose repositories...",
        "category": "Pair Review",
        "icon": "$(filter)"
      },
      {
        "command": "pairReview.hideRepository",
        "title": "Hide repository",
        "category": "Pair Review",
        "icon": "$(eye-closed)"
      },
      {
        "command": "pairReview.openPullRequestInBrowser",
        "title": "Open in browser",
        "category": "Pair Review",
        "icon": "$(link-external)"
      },
      {
        "command": "pairReview.openPullRequest",
        "title": "Open review page",
        "category": "Pair Review",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "pairReview.markGuideGroupRead",
        "title": "Mark section read",
        "category": "Pair Review",
        "icon": "$(check-all)"
      },
      {
        "command": "pairReview.pinPullRequest",
        "title": "Pin",
        "category": "Pair Review",
        "icon": "$(pin)"
      },
      {
        "command": "pairReview.unpinPullRequest",
        "title": "Unpin",
        "category": "Pair Review",
        "icon": "$(pinned)"
      },
      {
        "command": "pairReview.removePullRequestWorktree",
        "title": "Remove worktree",
        "category": "Pair Review",
        "icon": "$(trash)"
      },
      {
        "command": "pairReview.showPullRequestClaude",
        "title": "Show Claude activity",
        "category": "Pair Review",
        "icon": "$(output)"
      },
      {
        "command": "pairReview.showPullRequestOverview",
        "title": "Open review page",
        "category": "Pair Review",
        "icon": "$(dashboard)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pairReview",
          "title": "Pair Review",
          "icon": "resources/review.svg"
        }
      ]
    },
    "views": {
      "pairReview": [
        {
          "id": "pairReview.pullRequests",
          "name": "Pull Requests",
          "icon": "resources/review.svg"
        },
        {
          "id": "pairReview.local",
          "name": "Local",
          "icon": "resources/review.svg"
        },
        {
          "id": "pairReview.legend",
          "name": "Legend",
          "icon": "resources/review.svg",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pairReview.local",
        "contents": "Open a Git repository's top folder to review its local changes with Claude.",
        "when": "!pairReview.localAvailable"
      },
      {
        "view": "pairReview.pullRequests",
        "contents": "Sign in to GitHub to see your pull requests.\n[Sign in to GitHub](command:pairReview.signInToGitHub)",
        "when": "pairReview.gitHubSignIn == github"
      },
      {
        "view": "pairReview.pullRequests",
        "contents": "Sign in to your GitHub Enterprise host to see your pull requests.\n[Sign in to GitHub Enterprise](command:pairReview.signInToGitHub)",
        "when": "pairReview.gitHubSignIn == github-enterprise"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pairReview.addComment",
          "when": "(resourceScheme == file || resourceScheme == pair-review-pr) && isWorkspaceTrusted",
          "group": "navigation@20"
        }
      ],
      "editor/title": [
        {
          "command": "pairReview.addComment",
          "when": "(resourceScheme == file || resourceScheme == pair-review-pr) && isWorkspaceTrusted",
          "group": "navigation@20"
        }
      ],
      "view/title": [
        {
          "command": "pairReview.openLocalReview",
          "when": "view == pairReview.local && pairReview.localAvailable",
          "group": "navigation@1"
        },
        {
          "command": "pairReview.startClaude",
          "when": "view == pairReview.local",
          "group": "navigation@2"
        },
        {
          "command": "pairReview.refreshLocalFiles",
          "when": "view == pairReview.local && pairReview.localAvailable",
          "group": "navigation@3"
        },
        {
          "command": "pairReview.copyClaudeCommand",
          "when": "view == pairReview.local"
        },
        {
          "command": "pairReview.connectRunningClaude",
          "when": "view == pairReview.local"
        },
        {
          "command": "pairReview.searchPullRequests",
          "when": "view == pairReview.pullRequests",
          "group": "navigation@-1"
        },
        {
          "command": "pairReview.refreshPullRequests",
          "when": "view == pairReview.pullRequests",
          "group": "navigation@1"
        },
        {
          "command": "pairReview.filterByAuthor",
          "when": "view == pairReview.pullRequests && !pairReview.authorFiltered",
          "group": "navigation@0"
        },
        {
          "command": "pairReview.filterByAuthorActive",
          "when": "view == pairReview.pullRequests && pairReview.authorFiltered",
          "group": "navigation@0"
        },
        {
          "command": "pairReview.showGuideInTree",
          "when": "view == pairReview.pullRequests && !pairReview.treeShowsGuide",
          "group": "navigation@3"
        },
        {
          "command": "pairReview.showFilesInTree",
          "when": "view == pairReview.pullRequests && pairReview.treeShowsGuide",
          "group": "navigation@3"
        },
        {
          "command": "pairReview.viewFilesAsTree",
          "when": "view == pairReview.pullRequests && !pairReview.filesAsTree",
          "group": "navigation@2"
        },
        {
          "command": "pairReview.viewFilesAsList",
          "when": "view == pairReview.pullRequests && pairReview.filesAsTree",
          "group": "navigation@2"
        },
        {
          "command": "pairReview.chooseRepositories",
          "when": "view == pairReview.pullRequests",
          "group": "1_repositories@1"
        },
        {
          "command": "pairReview.groupByRepository",
          "when": "view == pairReview.pullRequests && pairReview.groupByRole",
          "group": "2_grouping@1"
        },
        {
          "command": "pairReview.groupByRole",
          "when": "view == pairReview.pullRequests && !pairReview.groupByRole",
          "group": "2_grouping@1"
        }
      ],
      "view/item/context": [
        {
          "command": "pairReview.pinPullRequest",
          "when": "view == pairReview.pullRequests && viewItem =~ /^pairReview\\.pullRequest(\\.checkedOut)?$/",
          "group": "inline@0"
        },
        {
          "command": "pairReview.unpinPullRequest",
          "when": "view == pairReview.pullRequests && viewItem =~ /^pairReview\\.pullRequest.*\\.pinned$/",
          "group": "inline@0"
        },
        {
          "command": "pairReview.openLocalFileInEditor",
          "when": "view == pairReview.local && viewItem == pairReview.localFile",
          "group": "inline"
        },
        {
          "command": "pairReview.markGuideGroupRead",
          "when": "view == pairReview.pullRequests && viewItem == pairReview.guideGroup",
          "group": "inline@0"
        },
        {
          "command": "pairReview.hideRepository",
          "when": "view == pairReview.pullRequests && viewItem == pairReview.repository",
          "group": "1_repository@1"
        },
        {
          "command": "pairReview.openPullRequestInBrowser",
          "when": "view == pairReview.pullRequests && viewItem =~ /^pairReview\\.pullRequest/",
          "group": "1_pullRequest@2"
        },
        {
          "command": "pairReview.showPullRequestClaude",
          "when": "view == pairReview.pullRequests && viewItem =~ /^pairReview\\.pullRequest\\.checkedOut/",
          "group": "1_pullRequest@1"
        },
        {
          "command": "pairReview.removePullRequestWorktree",
          "when": "view == pairReview.pullRequests && viewItem =~ /^pairReview\\.pullRequest\\.checkedOut/",
          "group": "2_worktree@0"
        },
        {
          "command": "pairReview.showPullRequestOverview",
          "when": "view == pairReview.pullRequests && viewItem =~ /^pairReview\\.pullRequest\\.checkedOut/",
          "group": "1_pullRequest@0"
        }
      ],
      "commandPalette": [
        {
          "command": "pairReview.pinPullRequest",
          "when": "false"
        },
        {
          "command": "pairReview.unpinPullRequest",
          "when": "false"
        },
        {
          "command": "pairReview.markGuideGroupRead",
          "when": "false"
        },
        {
          "command": "pairReview.filterByAuthorActive",
          "when": "false"
        },
        {
          "command": "pairReview.openPullRequestInBrowser",
          "when": "false"
        },
        {
          "command": "pairReview.openPullRequest",
          "when": "false"
        },
        {
          "command": "pairReview.removePullRequestWorktree",
          "when": "false"
        },
        {
          "command": "pairReview.showPullRequestClaude",
          "when": "false"
        },
        {
          "command": "pairReview.showPullRequestOverview",
          "when": "false"
        },
        {
          "command": "pairReview.hideRepository",
          "when": "false"
        },
        {
          "command": "pairReview.openLocalFile",
          "when": "false"
        },
        {
          "command": "pairReview.openLocalFileInEditor",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pairReview.addComment",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && (resourceScheme == file || resourceScheme == pair-review-base)"
      }
    ],
    "configuration": {
      "title": "Pair Review",
      "properties": {
        "pairReview.claudePath": {
          "type": "string",
          "default": "claude",
          "scope": "machine-overridable",
          "description": "Pfad zur Claude-Code-Anwendung. In vertrauenswürdigen Projekten überschreibbar."
        },
        "pairReview.nodePath": {
          "type": "string",
          "default": "node",
          "scope": "machine-overridable",
          "description": "Pfad zu Node.js 20 oder neuer. In vertrauenswürdigen Projekten überschreibbar."
        },
        "pairReview.transport": {
          "type": "string",
          "enum": [
            "hooks",
            "channels"
          ],
          "default": "hooks",
          "description": "Automatische Zustellung im Hintergrund (Standard: hooks). channels ist eine experimentelle Alternative mit zusätzlichen Voraussetzungen."
        },
        "pairReview.worktreeCleanupDays": {
          "type": "number",
          "default": 14,
          "minimum": 0,
          "description": "Remove a PR worktree that was not opened for this many days. Worktrees of merged or closed PRs are removed regardless. Worktrees with uncommitted changes or unpushed commits are always kept. 0 removes only merged or closed ones."
        },
        "pairReview.mockPullRequests": {
          "type": "boolean",
          "default": false,
          "description": "Show sample pull requests instead of querying GitHub. For development and testing only."
        }
      }
    }
  }
}
